<DevelopmentPlan VERSION="1.0.0">
  <Modules>
    <M-GOVERNANCE NAME="ProjectGovernance" TYPE="UTILITY"><purpose>Own branch, cleanup, authoring, stop, and full-gate rules.</purpose><inputs>Approved ARMY-97 design</inputs><outputs>AGENTS.md, .gitignore, shared contracts</outputs><verification-ref>V-M-GOVERNANCE</verification-ref></M-GOVERNANCE>
    <M-TASK-TEMPLATE NAME="TaskTemplate" TYPE="UTILITY"><purpose>Define the immutable task-XXXX student-card contract.</purpose><inputs>Task intent and controlled metadata</inputs><outputs>ConciseStudentTaskCard</outputs><depends>M-GOVERNANCE</depends><verification-ref>V-M-TASK-TEMPLATE</verification-ref></M-TASK-TEMPLATE>
    <M-TASK-VALIDATION NAME="TaskValidation" TYPE="UTILITY"><purpose>Own candidate decisions and full-catalog checks.</purpose><inputs>Army97CandidateRecord, candidate inventory</inputs><outputs>accepted decision, CardMigrationEvidence</outputs><depends>M-GOVERNANCE, M-TASK-TEMPLATE</depends><verification-ref>V-M-TASK-VALIDATION</verification-ref></M-TASK-VALIDATION>
